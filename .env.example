# Supabase project settings (Project Settings → API in the Supabase dashboard,
# or printed by `pnpm db:start` for the local stack). Both values are safe to expose
# to the browser; data is protected by row-level security in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
